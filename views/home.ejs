<!Doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tourism Hub</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <link rel='stylesheet' href='https://maxcdn.bootstrapcdn.com/font-awesome/4.6.3/css/font-awesome.min.css'>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <div class="wrapper">
    <div class="home">
      <div class="logo">
        <a href="#" class="travel"> <i class="fas fa-hiking"></i> Tourism. </a>
        <nav class="navbar">
          <a href="/">Home</a>
          <a href="/offbeat">Explore Offbeat</a>
          <a href="/guide">Guide</a> <a href="/aboutus">About Us</a>
          
          <a href="<%= typeof user !== 'undefined' && user ? '#' : '/login' %>" class="btn" id="user-greeting-btn">
            <%= typeof user !=='undefined' && user ? 'Welcome ' + user + '!' : 'Sign Up' %>
              <% if (!locals.user) { %>
                <svg viewBox="0 0 24 24" focusable="false" class="w-5 h-5 skew-x-[-20deg] arrow-icon">
                  <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"></path>
                </svg>
              <% } %>
          </a>
        </nav>
      </div>

      <div class="pic-setion">
        <div class="slide">
          <div class="box first">
            <div class="content_box">
              <h3>Kerala</h3>
              <p>Kerala is a coastal state located on the tropical Malabar Coast of southwestern India, along the Arabian Sea. It is known for its serene palm-fringed backwaters, rich cultural traditions, and diverse natural landscapes...</p>
              <a href="/generator" class="btn ">Plan Your Trip
                <svg viewBox="0 0 24 24" focusable="false" class="w-5 h-5 skew-x-[-20deg] arrow-icon">
                  <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <div class="slide">
          <div class="box second">
            <div class="content_box">
              <h3>Varanasi</h3>
              <p>The Varanasi Ghats are a series of historic stone riverfront steps lining the sacred Ganges River in Uttar Pradesh, northern India...</p>
              <a href="/generator" class="btn">Plan Your Trip
                <svg viewBox="0 0 24 24" focusable="false" class="w-5 h-5 skew-x-[-20deg] arrow-icon">
                  <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <div class="slide">
          <div class="box third">
            <div class="content_box">
              <h3>Kashmir</h3>
              <p>Kashmir is a picturesque valley region located in the northernmost part of the Indian subcontinent, cradled between the Great Himalayas...</p>
              <a href="/generator" class="btn">Plan Your Trip
                <svg viewBox="0 0 24 24" focusable="false" class="w-5 h-5 skew-x-[-20deg] arrow-icon">
                  <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <div class="slide">
          <div class="box fourth">
            <div class="content_box">
              <h3>Goa</h3>
              <p>Goa is a coastal state located in southwestern India along the Konkan region, bordering the Arabian Sea...</p>
              <a href="/generator" class="btn">Plan Your Trip
                <svg viewBox="0 0 24 24" focusable="false" class="w-5 h-5 skew-x-[-20deg] arrow-icon">
                  <path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
      </div>
    </div>

    <section class="service">
      <h1>We have the best services available for you!</h1>
      <div class="cards">
        <div class="item">
          <img src="./assets/1a.jpg" alt="">
          <h3>Flight Services</h3>
          <p>Arrival and departure</p>
        </div>
        <div class="item">
          <img src="./assets/2a.jpg" alt="">
          <h3>Food Services</h3>
          <p>Catering</p>
        </div>
        <div class="item">
          <img src="./assets/3a.jpg" alt="">
          <h3>Travel Services</h3>
          <p>Pick-up/drop</p>
        </div>
        <div class="item">
          <img src="./assets/4a.jpg" alt="">
          <h3>Hotel Services</h3>
          <p>Check-in/out</p>
        </div>
      </div>
    </section>

    <section class="package">
      <h2>Packages</h2>
      <div class="package-content">
        <div class="text-title">
          <h3>Best Selling Destinations</h3>
        </div>
        <a href="#"><div class="image"><img src="/assets/p1.jpg" alt=""><h3>Starting at Rs.2,700 </h3></div></a>
        <a href="#"><div class="image"><img src="/assets/p2.jpg" alt=""><h3>Starting at Rs.4,999 </h3></div></a>
        <a href="#"><div class="image"><img src="/assets/p3.jpg" alt=""><h3>Starting at Rs.9,999</h3></div></a>
        <a href="#"><div class="image"><img src="/assets/p4.jpg" alt=""><h3>Starting at Rs.30,000 </h3></div></a>
        <a href="#"><div class="image"><img src="/assets/pac1.jpeg" alt=""><h3>Starting at Rs.37,700/- </h3></div></a>
        <a href="#"><div class="image"><img src="/assets/pac1.jpg" alt=""><h3>Starting at Rs.47,500/- </h3></div></a>
        <a href="#"><div class="image"><img src="/assets/pac3.jpg" alt=""><h3>Starting at Rs.58,500/- </h3></div></a>
        <a href="#"><div class="image"><img src="/assets/pac7.jpg" alt=""><h3>Starting at Rs.59,500/- </h3></div></a>
        <a href="#"><div class="image"><img src="/assets/l1.jpg" alt=""><h3>Starting at Rs.65,500/-</h3></div></a>
      </div>
    </section>
    
    <%- include("./includes/footer.ejs") %>
  </div>
 
  <script src="/js/index.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const userBtn = document.getElementById('user-greeting-btn');
      if (userBtn) {
        userBtn.addEventListener('click', (e) => {
          // Check if the button currently displays a welcome message (i.e. user is logged in)
          if (userBtn.textContent.includes('Welcome')) {
            e.preventDefault();
            
            // Clear client-side storage data
            localStorage.removeItem('isLoggedIn');
            localStorage.removeItem('userEmail');
            localStorage.removeItem('userName');

            // Clear the cookie so Express server stops recognizing the logged-in user
            document.cookie = "userName=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";

            // Redirect user back to the login page
            window.location.href = '/login';
          }
        });
      }
    });
  </script>
</body>

</html>