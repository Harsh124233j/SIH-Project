<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tourism Hub — Log In & Registration</title>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- External CSS stylesheet -->
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>

    <!-- Floating Live SMS/Email Notification Banner (Simulated Delivery) -->
    <div id="otpNotificationToast" class="otp-toast hidden">
        <div class="toast-icon">
            <i class="fas fa-shield-halved"></i>
        </div>
        <div class="toast-content">
            <div class="toast-header-row">
                <span class="toast-title">Tourism Hub Verification</span>
                <span class="toast-time">Just now</span>
            </div>
            <p class="toast-body">
                Your one-time security code is: <strong id="toastOtpCode">123456</strong>. (Valid for 5 mins).
            </p>
        </div>
        <button type="button" id="toastFillBtn" class="toast-action-btn" title="Auto-fill OTP">
            Auto-fill
        </button>
    </div>

    <!-- Back to Home Button -->
    <a href="/" class="back-home-corner-btn">
        <i class="fas fa-arrow-left"></i> Home
    </a>

    <div class="container">
        <!-- Brand Logo Icon -->
        <div class="logo-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                <polyline points="10 17 15 12 10 7"></polyline>
                <line x1="15" y1="12" x2="3" y2="12"></line>
            </svg>
        </div>

        <h1 id="authPageTitle">Welcome back</h1>
        <p id="authPageSubtitle" class="subtitle">Log in to explore offbeat journeys</p>

        <!-- Main Card -->
        <div class="login-card">

            <!-- Auth Mode Switcher Tabs -->
            <div class="auth-tabs" id="authTabsContainer">
                <button type="button" class="tab-btn active" id="tabLoginBtn" data-target="loginView">
                    Log In
                </button>
                <button type="button" class="tab-btn" id="tabSignupBtn" data-target="signupView">
                    Sign Up
                </button>
            </div>

            <!-- ================= VIEW 1: LOG IN ================= -->
            <div id="loginView" class="auth-view active-view">
                <!-- Google Login Button -->
                <button class="google-btn" type="button">
                    <svg viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    Continue with Google
                </button>

                <div class="divider">
                    <span>OR</span>
                </div>

                <!-- Standard Email Login Form -->
                <form id="standardLoginForm">
                    <div class="form-group">
                        <label for="loginEmail">Email Address or Mobile</label>
                        <div class="input-wrapper email-spacing">
                            <i class="fas fa-envelope input-icon-fa"></i>
                            <input type="text" id="loginEmail" placeholder="you@example.com or 9876543210" required>
                        </div>
                    </div>

                    <div class="form-group" id="loginPasswordGroup">
                        <div class="form-label-row">
                            <label for="loginPassword">Password</label>
                            <a href="#" id="toggleOtpLoginBtn" class="forgot-link">Log in via OTP instead</a>
                        </div>
                        <div class="input-wrapper">
                            <i class="fas fa-lock input-icon-fa"></i>
                            <input type="password" id="loginPassword" placeholder="Enter your password">
                            <button type="button" class="eye-toggle-btn" data-target="loginPassword">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="submit-btn" id="loginSubmitBtn">
                        <span class="btn-text">Log in</span>
                        <i class="fas fa-arrow-right btn-icon"></i>
                    </button>
                </form>
            </div>

            <!-- ================= VIEW 2: SIGN UP (NEW REGISTRATION) ================= -->
            <div id="signupView" class="auth-view">
                <!-- Google Sign Up Button -->
                <button class="google-btn" type="button">
                    <svg viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    Sign up with Google
                </button>

                <div class="divider">
                    <span>OR REGISTER WITH DETAILS</span>
                </div>

                <!-- Registration Form -->
                <form id="signupForm">
                    <div class="form-group">
                        <label for="regName">Full Name</label>
                        <div class="input-wrapper">
                            <i class="fas fa-user input-icon-fa"></i>
                            <input type="text" id="regName" placeholder="e.g. Aryan Sharma" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="regEmail">Email Address</label>
                        <div class="input-wrapper">
                            <i class="fas fa-envelope input-icon-fa"></i>
                            <input type="email" id="regEmail" placeholder="you@example.com" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="regPhone">Mobile Number</label>
                        <div class="input-wrapper phone-input-wrapper">
                            <span class="country-badge">🇮🇳 +91</span>
                            <input type="tel" id="regPhone" placeholder="98765 43210" pattern="[0-9]{10}" maxlength="10" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="regPassword">Create Password</label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock input-icon-fa"></i>
                            <input type="password" id="regPassword" placeholder="Minimum 6 characters" minlength="6" required>
                            <button type="button" class="eye-toggle-btn" data-target="regPassword">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="submit-btn" id="signupSubmitBtn">
                        <span class="btn-text">Verify &amp; Register via OTP</span>
                        <i class="fas fa-shield-alt btn-icon"></i>
                    </button>
                </form>
            </div>

            <!-- ================= VIEW 3: OTP VERIFICATION ================= -->
            <div id="otpView" class="auth-view">
                <div class="otp-header">
                    <div class="otp-icon-bubble">
                        <i class="fas fa-key"></i>
                    </div>
                    <h3>Two-Step Verification</h3>
                    <p>
                        We have dispatched a 6-digit code to: <br>
                        <strong id="otpTargetDisplay">user@example.com</strong>
                    </p>
                </div>

                <!-- 6 Discrete Digit Boxes -->
                <div class="otp-boxes-container" id="otpBoxes">
                    <input type="text" class="otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]*" autofocus>
                    <input type="text" class="otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]*">
                    <input type="text" class="otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]*">
                    <input type="text" class="otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]*">
                    <input type="text" class="otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]*">
                    <input type="text" class="otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]*">
                </div>

                <div class="otp-helpers">
                    <div class="countdown-text" id="resendCountdown">
                        Resend code in <span id="timerSeconds">30</span>s
                    </div>
                    <button type="button" id="resendOtpBtn" class="resend-btn disabled" disabled>
                        Resend OTP
                    </button>
                </div>

                <button type="button" id="verifyOtpBtn" class="submit-btn">
                    <span class="btn-text">Confirm &amp; Proceed</span>
                    <i class="fas fa-check-circle btn-icon"></i>
                </button>

                <div class="otp-footer">
                    <button type="button" id="backFromOtpBtn" class="link-btn">
                        <i class="fas fa-arrow-left"></i> Change email or phone
                    </button>
                </div>
            </div>

        </div>

        <!-- Footer Bottom Links -->
        <div class="footer-text">
            <span id="footerTextPrompt">Don't have an account?</span>
            <a href="#" id="toggleTabLink">Create one now</a>
        </div>
    </div>
    
    <script src="/js/login.js"></script>
</body>
</html>