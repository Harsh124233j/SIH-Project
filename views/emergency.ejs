<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Emergency Contacts – Tourism</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel='stylesheet' href='https://maxcdn.bootstrapcdn.com/font-awesome/4.6.3/css/font-awesome.min.css'>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/emergency.css">
    <style>
        .em-nav-wrap { width:100%; position:relative; border:1px solid transparent; }
        .em-logo { width:80rem; display:flex; flex-direction:row; margin:2rem 5rem; align-items:center; position:relative; z-index:10; }
        .em-travel { text-decoration:none; margin-right:auto; font-size:2.5rem; color:#ffffff; font-weight:bolder; text-shadow:0 2px 4px rgba(0,0,0,0.5); }
        .em-travel i { color:#4ade80; }
        .em-navbar { text-transform:capitalize; font-size:1.6rem; margin-left:2rem; }
        .em-navbar a { padding:0 0.8rem; color:#ffffff; text-decoration:none; text-shadow:0 1px 3px rgba(0,0,0,0.5); transition:color 0.2s; }
        .em-navbar a:hover { color:#4ade80; }
        .em-btn { display:inline-flex; align-items:center; gap:10px; background-color:rgba(255,255,255,0.2); backdrop-filter:blur(5px); padding:10px 30px; margin-top:15px; color:#ffffff; border-radius:20px; font-size:1.4rem; border:0.2rem solid rgba(255,255,255,0.6); cursor:pointer; text-decoration:none; transition:all 0.2s; }
        .em-btn:hover { background-color:#10221b; color:#000; border-color:#4ade80; }
        .arrow-icon { width:1.6rem; }
        .back-link { display:inline-flex; align-items:center; gap:6px; color:#f87171; font-size:0.95rem; font-weight:500; margin:0 2rem 0 2rem; text-decoration:none; letter-spacing:0.5px; transition:color 0.2s; }
        .back-link:hover { color:#fca5a5; }
        .back-link:hover svg { transform:translateX(-3px); }
        @media(max-width:768px){.em-logo{flex-direction:column;width:100%;margin:1rem 0;}}
    </style>
</head>

<body>
    <div class="em-nav-wrap">
        <div class="em-logo">
            <a href="#" class="em-travel"><i class="fas fa-hiking"></i> Tourism.</a>
            <nav class="em-navbar">
                <a href="/">Home</a>
                <a href="/offbeat">Explore Offbeat</a>
                <a href="/guide">Guide</a>
                <a href="/aboutus">About Us</a>
                <a href="<%= typeof user !== 'undefined' && user ? '#' : '/login' %>" class="em-btn" id="user-greeting-btn">
                    <%= typeof user !== 'undefined' && user ? 'Welcome ' + user + '!' : 'Sign Up' %>
                    <% if (typeof user === 'undefined' || !user) { %>
                        <svg viewBox="0 0 24 24" focusable="false" class="arrow-icon"><path fill="currentColor" d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"></path></svg>
                    <% } %>
                </a>
            </nav>
        </div>
    </div>

    <a href="/offbeat" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="transition:transform 0.2s;">
            <path d="M19 12H5M12 19l-7-7 7-7" stroke="#f87171" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to Explore Offbeat
    </a>

