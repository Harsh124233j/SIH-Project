<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Details</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/detail.css">
</head>

<body>
  <img src="/css/jer.jpg" alt="" class="body_img">
  <!-- Header -->
  <header class="header-card">
    <h1 class="header-title">Day <%= dayItinerary["day"] %>: <%= dayItinerary["title"] %>
    </h1>
  </header>
  <div id="map" data-travel-routes='<%= JSON.stringify(dayItinerary.travel_between_locations || []) %>'
    data-api-key="<%= MAP_API_KEY %>"></div>

  <!-- Live Weather Forecast & Smart Packing Advisor (Exclusive to Show Details) -->
  <div class="header-card" style="margin-top: 2.5rem;">
    <div class="weather-header-row">
      <div>
        <h2 class="header-title" id="weatherTitle">
          <i class="fas fa-cloud-sun" style="color: #0284c7; margin-right: 8px;"></i>
          Live Weather & Smart Packing Guide
        </h2>
        <p class="weather-subtitle" id="weatherSubtitle">
          Destination: <strong><%= (typeof destination !== 'undefined' && destination) ? destination : 'Local Destination' %></strong>
          <% if (typeof month !== 'undefined' && month) { %>
            &bull; Travel Month: <strong><%= month %></strong>
          <% } %>
        </p>
      </div>
      <span class="weather-badge" id="weatherBadge">Forecast</span>
    </div>
  </div>

  <div class="weather-packing-card">
    <!-- Weather Snapshot Grid -->
    <div class="weather-snapshot-grid">
      <div class="weather-stat-box temp-box">
        <span class="stat-icon-large" id="weatherIcon">🌤️</span>
        <div class="stat-info">
          <span class="stat-label">Expected Temp</span>
          <span class="stat-value" id="weatherTemp">--°C</span>
          <span class="stat-subtext" id="weatherCondition">Loading live data...</span>
        </div>
      </div>
      
      <div class="weather-stat-box">
        <i class="fas fa-temperature-arrow-up stat-mini-icon" style="color: #f97316;"></i>
        <div class="stat-info">
          <span class="stat-label">Daily Range</span>
          <span class="stat-value" id="weatherRange">--</span>
          <span class="stat-subtext">Min / Max</span>
        </div>
      </div>

      <div class="weather-stat-box">
        <i class="fas fa-droplet stat-mini-icon" style="color: #0ea5e9;"></i>
        <div class="stat-info">
          <span class="stat-label">Humidity</span>
          <span class="stat-value" id="weatherHumidity">--%</span>
          <span class="stat-subtext">Relative Humidity</span>
        </div>
      </div>

      <div class="weather-stat-box">
        <i class="fas fa-wind stat-mini-icon" style="color: #64748b;"></i>
        <div class="stat-info">
          <span class="stat-label">Wind Speed</span>
          <span class="stat-value" id="weatherWind">-- km/h</span>
          <span class="stat-subtext" id="weatherSeason">Climate Norm</span>
        </div>
      </div>
    </div>

    <!-- Weather Advisory Summary -->
    <div class="weather-advice-box" id="weatherAdviceBox">
      <i class="fas fa-info-circle info-icon"></i>
      <div class="advice-content">
        <strong>Seasonal Advisory: </strong>
        <span id="weatherSummary">Analyzing local weather conditions for your journey...</span>
      </div>
    </div>

    <!-- Smart Packing Checklist Header -->
    <div class="packing-section-heading">
      <div class="packing-heading-left">
        <i class="fas fa-suitcase-rolling" style="color: #0284c7; font-size: 1.25rem;"></i>
        <h3 class="packing-heading-title">Destination Smart Packing Checklist</h3>
      </div>
      <span class="packing-counter" id="packingCounter">0 / 0 packed</span>
    </div>

    <!-- Categorized Checklist Grid -->
    <div class="packing-categories-grid" id="packingGrid">
      <div class="packing-loading-skeleton">Loading smart packing checklist tailored for <%= (typeof destination !== 'undefined' && destination) ? destination : 'destination' %>...</div>
    </div>
  </div>

  <!-- Schedule Section -->
  <div class="header-card cars" style="margin-top: 3rem;">
    <h2 class="header-title">Schedule</h2>
  </div>

  <div class="budget-list">
    <% if(dayItinerary && dayItinerary["schedule"]){ %>
      <% for(let sc of dayItinerary["schedule"]){ %>
        <div class="budget-item">
          <p class="budget-row">
            <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span class="label">Time :</span>
            <span class="value">
              <%= sc["time"] %>
            </span>
          </p>
          <p class="budget-row">
            <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <polygon
                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
            <span class="label">Activity :</span>
            <span class="value">
              <%= sc["activity"] %>
            </span>
          </p>
          <p class="budget-row">
            <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <line x1="8" y1="6" x2="21" y2="6" />
              <line x1="8" y1="12" x2="21" y2="12" />
              <line x1="8" y1="18" x2="21" y2="18" />
              <line x1="3" y1="6" x2="3.01" y2="6" />
              <line x1="3" y1="12" x2="3.01" y2="12" />
              <line x1="3" y1="18" x2="3.01" y2="18" />
            </svg>
            <span class="label">Description :</span>
            <span class="value">
              <%= sc["description"] %>
            </span>
          </p>
        </div>
        <% } %>
          <% } %>
  </div>

  <!-- Artisan Experience Section -->
  <div class="header-card" style="margin-top: 3rem;">
    <h2 class="header-title">Artisan Experience</h2>
  </div>

  <div class="budget-list">
    <div class="budget-item">
      <p class="budget-row">
        <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
        <span class="label">Workshop Name :</span>
        <span class="value">
          <%= dayItinerary["artisan_experience"]["workshop_name"] %>
        </span>
      </p>
      <p class="budget-row">
        <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 19l7-7 3 3-7 7-3-3z" />
          <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" />
        </svg>
        <span class="label">Craft Type :</span>
        <span class="value">
          <%= dayItinerary["artisan_experience"]["craft_type"] %>
        </span>
      </p>
      <p class="budget-row">
        <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
          <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        <span class="label">Authenticity :</span>
        <span class="value">
          <%= dayItinerary["artisan_experience"]["authenticity_details"] %>
        </span>
      </p>
    </div>
  </div>

  <!-- Travel Information Section -->
  <div class="header-card" style="margin-top: 3rem;">
    <h2 class="header-title">Travel Information</h2>
  </div>

  <div class="budget-list">
    <% for(let option of dayItinerary["travel_between_locations"]){ %>
      <div class="budget-item">
        <p class="budget-row">
          <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="10" r="3" />
            <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z" />
          </svg>
          <span class="label">Route :</span>
          <span class="value">
            <%= option["from"] %> &rarr; <%= option["to"] %>
          </span>
        </p>
        <p class="budget-row">
          <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <polyline points="4 17 10 11 4 5" />
            <line x1="12" y1="19" x2="20" y2="19" />
          </svg>
          <span class="label">Distance & Time :</span>
          <span class="value">
            <%= option["distance"] %> (<%= option["estimated_time"] %>)
          </span>
        </p>
        <p class="budget-row">
          <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="14" rx="2" />
            <path d="M3 10h18M7 18l-2 3M17 18l2 3" />
          </svg>
          <span class="label">Recommended Mode :</span>
          <span class="value">
            <%= option["recommended_mode"] %>
          </span>
        </p>
        <% for(let opt of option["options"]){ %>
          <p class="budget-row" style="padding-left: 28px;">
            <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="1" />
            </svg>
            <span class="label">
              <%= opt["mode"] %> :
            </span>
            <span class="value">
              <%= opt["fare"] %>
            </span>
          </p>
          <% } %>

            <div class="transit-quick-links">
              <a href="https://www.google.com/maps/dir/?api=1&origin=<%= encodeURIComponent(option['from']) %>&destination=<%= encodeURIComponent(option['to']) %>"
                target="_blank" rel="noopener noreferrer" class="mini-transit-btn maps-btn">
                🗺️ Google Maps Navigation
              </a>
              <% if(option['recommended_mode'].toLowerCase().includes('train') ||
                option['recommended_mode'].toLowerCase().includes('rail')) { %>
                <a href="https://www.confirmtkt.com/rts/search?from=<%= encodeURIComponent(option['from']) %>&to=<%= encodeURIComponent(option['to']) %>"
                  target="_blank" rel="noopener noreferrer" class="mini-transit-btn train-btn">
                  🚆 Book Train on IRCTC/ConfirmTkt
                </a>
                <% } else if(option['recommended_mode'].toLowerCase().includes('bus')) { %>
                  <a href="https://www.redbus.in/bus-tickets/<%= encodeURIComponent(option['from'].toLowerCase()) %>-to-<%= encodeURIComponent(option['to'].toLowerCase()) %>"
                    target="_blank" rel="noopener noreferrer" class="mini-transit-btn bus-btn">
                    🚌 Book Bus on RedBus
                  </a>
                  <% } else { %>
                    <a href="https://m.uber.com/ul/?action=setPickup&pickup=my_location&dropoff[formatted_address]=<%= encodeURIComponent(option['to']) %>"
                      target="_blank" rel="noopener noreferrer" class="mini-transit-btn cab-btn">
                      🚕 Check Cab Rates
                    </a>
                    <% } %>
            </div>
      </div>
      <% } %>
  </div>

  <!-- Accommodations Section -->
  <div class="header-card" style="margin-top: 3rem;">
    <h2 class="header-title">Accommodations</h2>
  </div>

  <% if(dayAccom){ %>
    <div class="budget-list">
      <div class="budget-item">
        <p class="budget-row">
          <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            <polyline points="9 22 9 12 15 12 15 22" />
          </svg>
          <span class="label">Name :</span>
          <span class="value">
            <%= dayAccom["name"] %> (<%= dayAccom["type"] %>)
          </span>
        </p>
        <p class="budget-row">
          <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h12M6 8h12M6 13l8.5 8M6 13h3a4 4 0 0 0 0-8" />
          </svg>
          <span class="label">Price Per Night :</span>
          <span class="value">
            <%= dayAccom["price_per_night"] %>
          </span>
        </p>
        <p class="budget-row">
          <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="10" r="3" />
            <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z" />
          </svg>
          <span class="label">Location :</span>
          <span class="value">
            <%= dayAccom["location"] %>
          </span>
        </p>
        <p class="budget-row">
          <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
          </svg>
          <span class="label">Facilities :</span>
          <span class="value">
            <%= dayAccom["facilities"].join(", ") %></span>
        </p>
        <p class=" budget-row">
              <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="16" x2="12" y2="12" />
                <line x1="12" y1="8" x2="12.01" y2="8" />
              </svg>
              <span class="label">Why Choose :</span>
              <span class="value">
                <%= dayAccom["why_choose"] %>
              </span>
        </p>

        <!-- REAL BOOKING ACTION BUTTONS -->
        <div class="booking-card-actions">
          <a href="<%= (typeof bookingLinks !== 'undefined' && bookingLinks && bookingLinks.hotels) ? bookingLinks.hotels.bookingCom : 'https://www.booking.com/searchresults.html?ss=' + encodeURIComponent(dayAccom['name'] + ' ' + dayAccom['location']) %>"
            target="_blank" rel="noopener noreferrer" class="live-booking-btn bookingcom-btn">
            <span class="btn-emoji">🏨</span> Book on Booking.com <span class="arr-icon">&nearr;</span>
          </a>
          <a href="<%= (typeof bookingLinks !== 'undefined' && bookingLinks && bookingLinks.hotels) ? bookingLinks.hotels.googleHotels : 'https://www.google.com/travel/hotels/' + encodeURIComponent(dayAccom['location']) + '?q=' + encodeURIComponent(dayAccom['name']) %>"
            target="_blank" rel="noopener noreferrer" class="live-booking-btn ghotels-btn">
            <span class="btn-emoji">🔍</span> Compare Google Hotels <span class="arr-icon">&nearr;</span>
          </a>
          <a href="<%= (typeof bookingLinks !== 'undefined' && bookingLinks && bookingLinks.hotels) ? bookingLinks.hotels.agoda : 'https://www.agoda.com/search?text=' + encodeURIComponent(dayAccom['name']) %>"
            target="_blank" rel="noopener noreferrer" class="live-booking-btn agoda-btn">
            <span class="btn-emoji">🏷️</span> Agoda Live Deals <span class="arr-icon">&nearr;</span>
          </a>
        </div>
      </div>
    </div>
    <% }else{ %>
      <div class="budget-list">
        <div class="budget-item">
          <p class="budget-row">
            <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
            <span class="label">No Accommodation Required</span>
          </p>
        </div>
      </div>
      <% } %>


        <script src="/js/map.js" defer></script>
  <!-- Live Weather & Smart Packing Client Loader -->
  <script>
    document.addEventListener("DOMContentLoaded", async () => {
      const city = "<%= (typeof destination !== 'undefined' && destination) ? destination : 'Jaipur' %>";
      const month = "<%= (typeof month !== 'undefined' && month) ? month : '' %>";
      
      try {
        const res = await fetch(`/api/weather?city=${encodeURIComponent(city)}&month=${encodeURIComponent(month)}`);
        if (!res.ok) return;
        const data = await res.json();
        
        const iconEl = document.getElementById("weatherIcon");
        const badgeEl = document.getElementById("weatherBadge");
        const tempEl = document.getElementById("weatherTemp");
        const condEl = document.getElementById("weatherCondition");
        const rangeEl = document.getElementById("weatherRange");
        const humEl = document.getElementById("weatherHumidity");
        const windEl = document.getElementById("weatherWind");
        const seasonEl = document.getElementById("weatherSeason");
        const summaryEl = document.getElementById("weatherSummary");

        if (iconEl) iconEl.textContent = data.icon || "🌤️";
        if (badgeEl) {
          badgeEl.textContent = data.isRainy ? "Monsoon / Rainy" : (data.season || (data.dataSource ? data.dataSource.split(" ")[0] : "Live Forecast"));
          if (data.isRainy) badgeEl.classList.add("badge-rainy");
        }
        if (tempEl) tempEl.textContent = `${data.temperature}°C`;
        if (condEl) condEl.textContent = data.condition || "Pleasant";
        if (rangeEl) rangeEl.textContent = data.tempRange || `${data.temperature}°C`;
        if (humEl) humEl.textContent = `${data.humidity}%`;
        if (windEl) windEl.textContent = `${data.windSpeed} km/h`;
        if (seasonEl) seasonEl.textContent = data.month || "Season";
        if (summaryEl) summaryEl.textContent = data.summary || "";

        const grid = document.getElementById("packingGrid");
        if (!grid) return;
        grid.innerHTML = "";

        const cat = data.categorizedPacking || {};
        const categories = [
          { title: "Clothing & Layers", icon: "fa-tshirt", items: cat.clothing || [] },
          { title: "Weather Gear & Protection", icon: "fa-umbrella", items: cat.weatherGear || [] },
          { title: "Footwear & Mobility", icon: "fa-shoe-prints", items: cat.footwear || [] },
          { title: "Essentials & Cultural Etiquette", icon: "fa-shield-halved", items: [...(cat.essentials || []), ...(cat.culturalTips || [])] }
        ];

        let totalItems = 0;
        let checkedItems = 0;

        function updateProgress() {
          const counterEl = document.getElementById("packingCounter");
          if (counterEl) {
            counterEl.textContent = `${checkedItems} / ${totalItems} packed`;
          }
        }

        categories.forEach(c => {
          if (!c.items || c.items.length === 0) return;
          totalItems += c.items.length;
          const card = document.createElement("div");
          card.className = "packing-category-card";
          card.innerHTML = `
            <div class="packing-cat-header">
              <i class="fas ${c.icon}"></i>
              <h4>${c.title}</h4>
            </div>
            <ul class="packing-items-list">
              ${c.items.map(item => `
                <li>
                  <label class="packing-item-label">
                    <input type="checkbox" class="pack-checkbox" />
                    <span class="pack-text">${item}</span>
                  </label>
                </li>
              `).join("")}
            </ul>
          `;
          grid.appendChild(card);
        });

        grid.addEventListener("change", (e) => {
          if (e.target && e.target.classList.contains("pack-checkbox")) {
            const itemText = e.target.closest("label").querySelector(".pack-text");
            if (e.target.checked) {
              if (itemText) itemText.classList.add("item-packed");
              checkedItems++;
            } else {
              if (itemText) itemText.classList.remove("item-packed");
              checkedItems--;
            }
            updateProgress();
          }
        });

        updateProgress();
      } catch (e) {
        console.warn("Could not load weather details:", e);
      }
    });
  </script>
</body>

</html>