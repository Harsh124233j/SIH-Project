<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Itenary</title>
    <link rel="stylesheet" href="/css/ai.css">
  </head>
  <body>
   <img src="/css/jer.jpg" alt="" width="900px" height="860px" class="body_img">
    <div class="wrapper ">
      
      <!-- header file -->
        <header class="header">
          <h1>Day by Day Itinerary <span id="loading-spinner" style="font-size: 1rem; color: gray;">(Generating...)</span></h1>
           <p id="trip-overview">
            
          </p>
  </header>

      <!-- FIRST SECTION  -->
     <!-- days schedule container -->

      <div class="day_container" id="summary_container">

      </div>
      <!-- SECOND SECTION  -->

      <div class="transport ">

          <div class="header hub">
            <svg class="header-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
          <h3 >Nearby Transport Hubs</h3>
          </div>

            <!-- vehicle section  -->
            <div class="day_container vehicle" id="transport_container"> 
  
            </div>

      </div>
    <!-- <h3>Budget Estimates :</h3> -->



      <div class="budget">
        <div class="header hub" >
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4" />
            <path d="M3 5v14a2 2 0 0 0 2 2h16v-5" />
            <path d="M18 12a2 2 0 0 0 0 4h4v-4Z" />
          </svg>
          <h2>Budget</h2>
        </div>

       <div class="day_container vehicle">
        <h2>Normal range :</h2>
         <!-- Accomodations -->
       <div class="budget-item">
    <p class="budget-row">
      <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      <span class="label">Accommodation :</span>
      <span class="value" id="budget_accom"></span>
    </p>
  </div>

  <!-- Local Transport -->
  <div class="budget-item">
    <p class="budget-row">
      <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="14" rx="2"/>
        <path d="M3 10h18M7 18l-2 3M17 18l2 3"/>
      </svg>
      <span class="label">Local Transport :</span>
      <span class="value" id="budget_lt"></span>
    </p>
  </div>

  <!-- Intercity Transport -->
  <div class="budget-item">
    <p class="budget-row">
      <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/>
      </svg>
      <span class="label">Intercity Transport :</span>
      <span class="value" id="budget_it"></span>
    </p>
  </div>

  <!-- Entry Tickets -->
  <div class="budget-item">
    <p class="budget-row">
      <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/>
        <line x1="13" y1="5" x2="13" y2="19" stroke-dasharray="2"/>
      </svg>
      <span class="label">Entry Tickets :</span>
      <span class="value" id="budget_et"></span>
    </p>
  </div>

  <!-- Food -->
  <div class="budget-item">
    <p class="budget-row">
      <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
        <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
        <line x1="6" y1="1" x2="6" y2="4"/>
        <line x1="10" y1="1" x2="10" y2="4"/>
        <line x1="14" y1="1" x2="14" y2="4"/>
      </svg>
      <span class="label">Food :</span>
      <span class="value" id="budget_food"></span>
    </p>
  </div>

  <!-- Miscellaneous -->
  <div class="budget-item">
    <p class="budget-row">
      <svg class="budget-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
        <line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
      <span class="label">Miscellaneous :</span>
      <span class="value" id="budget_misc"></span>
    </p>
  </div>

  <!-- Total -->
  <div class="budget-item total">
    <p class="budget-row">
      <svg class="budget-icon total-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/>
        <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/>
        <path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/>
      </svg>
      <span class="label">Total :</span>
      <span class="value" id="budget_total"></span>
    </p>
  </div>
       </div>

      </div>


        <div class="day_container vehicle">
