<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us & Contact</title>
    <!-- Google Fonts & Font Awesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/about-us.css">
</head>
<body>

   <div class="wrapper">
     <main class="container">
        
        <!-- Intro Hero Section -->
        <section class="intro-card animate-fade-in">
            <span class="tag">Who We Are</span>
            <h1>Crafting Tomorrow's Digital Experience</h1>
            <p>
                We are a collective of passionate creators, thinkers, and builders. Driven by curiosity and craft, 
                we unite our diverse skills to turn complex ideas into elegant, impactful real-world creations.
            </p>
        </section>

        <!-- The Creative Minds Section (Horizontal Marquee with Original Cards) -->
        <section class="team-section animate-slide-up">
            <h2>The Creative Minds</h2>
            
            <div class="marquee-container">
                <div class="marquee-track">
                    
                    <!-- Original Set of Cards -->
                    <div class="team-card">
                        <div class="avatar"><i class="fa-solid fa-lightbulb"></i></div>
                        <h3>Aryan</h3>
                        <p>Conceptualizing fresh perspectives, guiding strategic direction, and breathing life into bold initiatives.</p>
                    </div>

                    <div class="team-card">
                        <div class="avatar"><i class="fa-solid fa-layer-group"></i></div>
                        <h3>Harsh</h3>
                        <p>Mastering core structures, performance optimization, and building rock-solid foundations.</p>
                    </div>

                    <div class="team-card">
                        <div class="avatar"><i class="fa-solid fa-shapes"></i></div>
                        <h3>Himanshu</h3>
                        <p>Harmonizing functionality with user needs to curate seamless and memorable digital journeys.</p>
                    </div>

                    <div class="team-card">
                        <div class="avatar"><i class="fa-solid fa-palette"></i></div>
                        <h3>Kashvi</h3>
                        <p>Crafting visual harmony, modern aesthetics, and intuitive interfaces with meticulous attention to detail.</p>
                    </div>

                    <div class="team-card">
                        <div class="avatar"><i class="fa-solid fa-code"></i></div>
                        <h3>Divyansh</h3>
                        <p>Translating creative concepts into interactive experiences through robust code and modern tooling.</p>
                    </div>

                    <div class="team-card">
                        <div class="avatar"><i class="fa-solid fa-bolt"></i></div>
                        <h3>Kavyansh</h3>
                        <p>Energizing workflow execution, community outreach, and continuous product enhancement.</p>
                    </div>

                    <!-- Duplicated Set for Seamless Loop -->
                    <div class="team-card" aria-hidden="true">
                        <div class="avatar"><i class="fa-solid fa-lightbulb"></i></div>
                        <h3>Aryan</h3>
                        <p>Conceptualizing fresh perspectives, guiding strategic direction, and breathing life into bold initiatives.</p>
                    </div>

                    <div class="team-card" aria-hidden="true">
                        <div class="avatar"><i class="fa-solid fa-layer-group"></i></div>
                        <h3>Harsh</h3>
                        <p>Mastering core structures, performance optimization, and building rock-solid foundations.</p>
                    </div>

                    <div class="team-card" aria-hidden="true">
                        <div class="avatar"><i class="fa-solid fa-shapes"></i></div>
                        <h3>Himanshu</h3>
                        <p>Harmonizing functionality with user needs to curate seamless and memorable digital journeys.</p>
                    </div>

                    <div class="team-card" aria-hidden="true">
                        <div class="avatar"><i class="fa-solid fa-palette"></i></div>
                        <h3>Kashvi</h3>
                        <p>Crafting visual harmony, modern aesthetics, and intuitive interfaces with meticulous attention to detail.</p>
                    </div>

                    <div class="team-card" aria-hidden="true">
                        <div class="avatar"><i class="fa-solid fa-code"></i></div>
                        <h3>Divyansh</h3>
                        <p>Translating creative concepts into interactive experiences through robust code and modern tooling.</p>
                    </div>

                    <div class="team-card" aria-hidden="true">
                        <div class="avatar"><i class="fa-solid fa-bolt"></i></div>
                        <h3>Kavyansh</h3>
                        <p>Energizing workflow execution, community outreach, and continuous product enhancement.</p>
                    </div>

                </div>
            </div>
        </section>

        <!-- Contact Us Section -->
        <section class="contact-section animate-slide-up">
            <h2>Get In Touch</h2>
            
            <div class="contact-wrapper">
                <!-- Contact Details Card -->
                <div class="contact-card details-card">
                    <h3>Contact Information</h3>
                    <p class="contact-subtext">Feel free to reach out to our dedicated departments.</p>

                    <div class="contact-group">
                        <div class="contact-item">
                            <i class="fa-solid fa-envelope"></i>
                            <div>
                                <strong>Email Inquiries</strong>
                                <span>hello@ourbrand.com</span>
                                <span>support@ourbrand.com</span>
                                <span>collaborations@ourbrand.com</span>
                            </div>
                        </div>

                        <div class="contact-item">
                            <i class="fa-solid fa-phone"></i>
                            <div>
                                <strong>Phone Lines</strong>
                                <span>+1 (800) 234-5678 (General)</span>
                                <span>+1 (800) 876-5432 (Support)</span>
                                <span>+1 (800) 345-6789 (Direct Line)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Social Handles -->
                    <div class="social-box">
                        <p>Follow Our Journey</p>
                        <div class="social-icons">
                            <a href="https://facebook.com" target="_blank" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                            <a href="https://instagram.com" target="_blank" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                            <a href="https://x.com" target="_blank" aria-label="X Twitter"><i class="fa-brands fa-x-twitter"></i></a>
                        </div>
                    </div>
                </div>

                <!-- Contact Message Box -->
                <div class="contact-card form-card">
                    <h3>Send a Message</h3>
                    <form class="contact-form" onsubmit="event.preventDefault();">
                        <div class="input-group">
                            <input type="text" placeholder="Your Name" required>
                        </div>
                        <div class="input-group">
                            <input type="email" placeholder="Your Email" required>
                        </div>
                        <div class="input-group">
                            <textarea rows="4" placeholder="Your Message..." required></textarea>
                        </div>
                        <button type="submit" class="submit-btn">Send Message <i class="fa-solid fa-paper-plane"></i></button>
                    </form>
                </div>
            </div>
        </section>
       
    </main>
   
   </div>

</body>
</html>